  "audioReactors": {
    "enabled": true,
    "nodes": [
      {
        "name": "Давление Тьмы (Бас)",
        "description": "Уплотнение теней на низких частотах. База снижена, чтобы кадр не проваливался в чёрное.",
        "target": "#shadow-crush-overlay",
        "cssProperty": "opacity",
        "formulaParts": [
          { "code": "calc(0.1 + var(--bass) * 0.16)", "note": "Мягкое затемнение по басу" }
        ],
        "transition": "opacity 0.06s ease-out"
      },
      {
        "name": "Плашка плывёт (Бит и Бас)",
        "description": "Плашка субтитров медленно дрейфует под ритм: горизонталь — от удара, вертикаль — от баса.",
        "target": ".subtitle-text-inline",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "translate(calc(var(--beat) * -1.5px), calc(var(--bass) * 2.5px))", "note": "Дрейф по двум осям" },
          { "code": "rotate(calc(var(--beat) * 0.12deg))", "note": "Едва заметный крен" }
        ],
        "transition": "transform 0.09s ease-out"
      },
      {
        "name": "Дыхание Плёнки (Бит)",
        "description": "Атмосферный слой (пыль, шум, полосы) чуть дышит на каждом ударе.",
        "target": "#host-dust",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "scale(calc(1 + var(--beat) * 0.004))", "note": "Дыхание текстуры" }
        ],
        "transition": "transform 0.12s ease-out"
      },
      {
        "name": "Свет Надежды (Гейт финала)",
        "description": "С 316-й секунды кадр постепенно выходит из тьмы в цвет и свет.",
        "target": "#host-images",
        "cssProperty": "filter",
        "formulaParts": [
          { "code": "brightness(calc(1 + var(--gate) * 0.22))", "note": "Просветление финала" },
          { "code": "saturate(calc(1 + var(--gate) * 0.25))", "note": "Возврат цвета" }
        ],
        "activeFrom": 316.0,
        "activeDuration": 9.968,
        "transition": "filter 0.5s ease-in"
      },
      {
        "name": "Медленное Приближение (Огибающая)",
        "description": "Плавный наезд по огибающей: почти незаметен весь клип и раскрывается к последней секунде.",
        "target": "#host-images",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "scale(calc(1 + var(--env) * 0.03))", "note": "Рост масштаба по огибающей" }
        ],
        "envelope": {
          "mode": "curve",
          "points": [
            { "x": 0.0, "y": 0.0 },
            { "x": 0.9, "y": 0.08 },
            { "x": 1.0, "y": 1.0 }
          ]
        },
        "transition": "transform 0.2s ease-out"
      },
      {
        "name": "Чёрная вспышка (Вход в серую секцию)",
        "description": "Короткое затемнение до чёрного на входе в секцию «воет ветер» (264.7 s).",
        "target": "#screen-flash-overlay",
        "cssProperty": "opacity",
        "formulaParts": [
          { "code": "var(--gate)", "note": "0 -> 1 -> 0 за 0.35 s" }
        ],
        "activeFrom": 264.7,
        "activeDuration": 0.35,
        "transition": "opacity 0.18s ease-out"
      },
      {
        "name": "Сердцебиение (Припев)",
        "description": "В припеве кадр отвечает на бас как на редкие удары сердца и медленно плывёт от вокала.",
        "target": "#host-images",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "scale(calc(1 + var(--bass) * 0.012))", "note": "Толчок от баса" },
          { "code": "translateY(calc(var(--vocal) * -3px))", "note": "Дрейф от вокала" }
        ],
        "activeFrom": 202.0,
        "activeDuration": 32.0,
        "transition": "transform 0.12s ease-out"
      },
      {
        "name": "Виньетка дышит (Бас)",
        "description": "Тёмная виньетка по краям кадра: заполнение меняется на каждом низе.",
        "target": ".vignette-layer",
        "cssProperty": "opacity",
        "formulaParts": [
          { "code": "calc(0.45 + var(--bass) * 0.45)", "note": "Заполнение по басу" }
        ],
        "transition": "opacity 0.09s ease-out"
      },
      {
        "name": "Небо темнеет (02:53, Припев 2)",
        "description": "В секции 172-202 s кадр сильнее проваливается в тень на каждом низе.",
        "target": "#host-images",
        "cssProperty": "filter",
        "formulaParts": [
          { "code": "brightness(calc(1 - var(--bass) * 0.14))", "note": "Затемнение по басу" }
        ],
        "activeFrom": 172.0,
        "activeDuration": 30.0,
        "transition": "filter 0.1s ease-out"
      },
      {
        "name": "Голос ведёт плашку — сепия",
        "description": "Вариант 1 (001-002): плашка всплывает и чуть растёт на голосе.",
        "target": ".subtitle-text-inline",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "translateY(calc(var(--vocal) * -4px))", "note": "Подъём на голосе" },
          { "code": "scale(calc(1 + var(--vocal) * 0.012))", "note": "Рост" }
        ],
        "activeFrom": 0.0,
        "activeDuration": 50.0,
        "transition": "transform 0.12s ease-out"
      },
      {
        "name": "Голос ведёт плашку — лагерь",
        "description": "Вариант 2 (003-009): плашку ведёт в сторону с наклоном, как от дыхания.",
        "target": ".subtitle-text-inline",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "skewX(calc(var(--vocal) * 1.2deg))", "note": "Наклон от голоса" },
          { "code": "translateX(calc(var(--vocal) * 3px))", "note": "Снос в сторону" }
        ],
        "activeFrom": 54.0,
        "activeDuration": 211.0,
        "transition": "transform 0.14s ease-out"
      },
      {
        "name": "Голос ведёт плашку — монохром",
        "description": "Вариант 3 (010-012): медленное оседание вниз с микроповоротом.",
        "target": ".subtitle-text-inline",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "translateY(calc(var(--vocal) * 3px))", "note": "Оседание" },
          { "code": "rotate(calc(var(--vocal) * 0.3deg))", "note": "Микроповорот" }
        ],
        "activeFrom": 265.0,
        "activeDuration": 51.0,
        "transition": "transform 0.18s ease-out"
      },
      {
        "name": "Голос ведёт плашку — финал",
        "description": "Вариант 4 (013): плашка распрямляется и подаётся вперёд, к свету.",
        "target": ".subtitle-text-inline",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "scale(calc(1 + var(--vocal) * 0.03))", "note": "Подача вперёд" },
          { "code": "translateY(calc(var(--vocal) * -2px))", "note": "Подъём" }
        ],
        "activeFrom": 316.0,
        "activeDuration": 10.0,
        "transition": "transform 0.16s ease-out"
      }
    ]
  },
