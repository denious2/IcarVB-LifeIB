  "beatsConfig": {
    "enabled": true,
    "sourceFile": "beats.json",
    "decay": 0.15,
    "multiplier": 1,
    "type": "solid",
    "dynamics": "sharp",
    "color": "#ffffff",
    "intensity": 0.25
  },
  "bass": { "enabled": true, "sourceFile": "bass.json", "decay": 0.3 },
  "melody": { "enabled": true, "sourceFile": "melody.json", "decay": 0.2 },
  "vocal": { "enabled": true, "sourceFile": "vocal.json", "decay": 0.2 },
  "accents": {
    "enabled": true,
    "sourceFile": "accents.json",
    "shakes": {
      "enabled": true,
      "duration": 0.25,
      "pool": ["capcut_shake_v1", "micro_seismic", "impact_zoom"]
    },
    "videoGlitches": {
      "enabled": true,
      "duration": 0.35,
      "file": "media/sfx/accents/glitch-vert-12.mp4",
      "blendMode": "screen",
      "slices": 8,
      "sequence": [2, 3, "none", "none", 5],
      "style": "white_soft_20"
    }
  },
  "audioReactors": {
    "enabled": true,
    "nodes": [
      {
        "name": "Давление Тьмы (Бас)",
        "description": "Уплотнение теней на низких частотах.",
        "target": "#shadow-crush-overlay",
        "cssProperty": "opacity",
        "formulaParts": [
          { "code": "calc(0.2 + var(--bass) * 0.2)", "note": "Снижена база" }
        ],
        "transition": "opacity 0.05s ease-out"
      },
      {
        "name": "Нервный Текст (Субтитры)",
        "description": "Текст слегка вздрагивает на басах.",
        "target": "#host-subs",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "skewX(calc(var(--bass) * -1deg))", "note": "Наклон текста" },
          { "code": "scale(calc(1 + var(--bass) * 0.05))", "note": "Пульсация размера" }
        ],
        "transition": "transform 0.05s ease-out"
      }
    ]
  },
